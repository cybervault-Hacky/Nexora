{
  "name": "@nexora/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official Nexora website (React + TypeScript + Vite)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:netlify": "tsc --noEmit && vite build && node scripts/prepare-netlify-redirects.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "portal": "node server/index.mjs",
    "provision-owner": "node server/provision-owner.mjs",
    "test:portal": "node --test \"server/tests/*.test.mjs\""
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
