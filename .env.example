# ==============================================================================
# Nexora Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. Copy this file to `.env` on the backend host for local development:
#      cp .env.example .env && chmod 600 .env
#    NEVER commit `.env` or any file containing real credentials to Git.
# 2. Secret-bearing settings below are blank or unmistakable placeholders only.
#    The auth service validates production configuration at startup and refuses
#    missing DB configuration, placeholder credentials, and insecure remote DB URLs.
# 3. Stripe/payment integration is disabled in service composition regardless
#    of credentials. Never configure payment secrets to try to activate it.
# 4. NEVER prefix any backend secret with `VITE_`; frontend bundles must never
#    contain server credentials, database strings, payment keys, or OAuth secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Mode & Network Binding (`services/nexora-auth`)
# ------------------------------------------------------------------------------
# Allowed values: `development` | `test` | `production`. The auth service defaults to
# development only in debug builds; release deployments must set this explicitly.
# Desktop mode is pinned at build time (release default: production); runtime mode
# changes are rejected so a production package cannot be downgraded.
NEXORA_ENV=development

# Socket address `services/nexora-auth` listens on (`IP:PORT`).
# Non-loopback binds are rejected unless `NEXORA_AUTH_ALLOW_NON_LOOPBACK=true`.
NEXORA_AUTH_BIND=127.0.0.1:8787
NEXORA_AUTH_ALLOW_NON_LOOPBACK=false

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16+ Account, Billing & Quota Database (`services/nexora-auth`)
# ------------------------------------------------------------------------------
# Optional in development/test; required in production. Remote production hosts
# must set `sslmode=require`, `verify-ca`, or `verify-full`; loopback is exempt.
# Leave blank for offline/local development until an isolated DB is available.
NEXORA_AUTH_DATABASE_URL=

# Isolated database URL used exclusively by `cargo test -- --include-ignored`
# (truncates tables between integration tests — NEVER point at production!).
NEXORA_AUTH_TEST_DATABASE_URL=postgresql://postgres:REPLACE_WITH_TEST_DB_PASSWORD@127.0.0.1:5432/nexora_auth_test

# ------------------------------------------------------------------------------
# 3. Session, Password Recovery & Rate-Limit Policy (`services/nexora-auth`)
# ------------------------------------------------------------------------------
NEXORA_AUTH_VERIFICATION_TTL_SECONDS=86400
NEXORA_AUTH_SESSION_TTL_SECONDS=2592000
NEXORA_AUTH_SESSION_IDLE_TTL_SECONDS=604800
NEXORA_AUTH_RESET_TTL_SECONDS=3600

# Sliding-window rate rules (`<count>/<window>`, e.g. `5/15m`, `5/1h`, `3/1h`):
NEXORA_AUTH_RATE_LIMIT_LOGIN=5/15m
NEXORA_AUTH_RATE_LIMIT_REGISTER=5/1h
NEXORA_AUTH_RATE_LIMIT_RESEND=3/1h
NEXORA_AUTH_RATE_LIMIT_RECOVERY=3/1h

# ------------------------------------------------------------------------------
# 4. Transactional Email Provider (`services/nexora-auth`)
# ------------------------------------------------------------------------------
# Supported build value: `unconfigured` (honestly reports unconfigured delivery;
# setting `NEXORA_AUTH_SMTP_*` without an active transport fails fast rather than
# pretending mail was delivered).
NEXORA_AUTH_EMAIL_PROVIDER=unconfigured

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 + OIDC PKCE (`services/nexora-auth` & Desktop Client)
# ------------------------------------------------------------------------------
# Public Installed/Desktop OAuth Client ID opened by the desktop app with S256 PKCE.
# Set it when building the desktop package; the public ID is embedded so a
# Start-menu/Dock launch does not depend on its parent shell. A runtime
# process-environment value can override it. Missing/placeholders disable sign-in.
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Backend OAuth configuration. The client ID is public; the client secret is
# confidential and server-only. Leave all blank to keep Google sign-in unavailable.
NEXORA_AUTH_GOOGLE_CLIENT_ID=
NEXORA_AUTH_GOOGLE_CLIENT_SECRET=

# RFC 8252 §7.3 loopback callback base; required only when backend OAuth is configured.
# The desktop binds a dynamic 127.0.0.1 port.
NEXORA_AUTH_GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------------------------
# 6. Existing Stripe-Oriented Payment Settings (Audit Only)
# ------------------------------------------------------------------------------
# Phase 15 Razorpay work is blocked and was not implemented. Existing Stripe
# source is retained for audit only; production composition forcibly keeps the
# provider and webhook secret unavailable regardless of these values. Do not
# configure payment secrets, prices, quotas, or Premium claims.
# BACKEND SERVER ONLY — keep both empty; never embed provider secrets in desktop:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Historical Stripe Price ID variable names retained as comments for source audit
# only. Do not set them: there are no approved prices and payment composition
# ignores these settings regardless of credentials.
# STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_WITH_PRO_MONTHLY_ID
# STRIPE_PRICE_PRO_YEARLY=price_REPLACE_WITH_PRO_YEARLY_ID
# STRIPE_PRICE_TEAM_MONTHLY=price_REPLACE_WITH_TEAM_MONTHLY_ID
# STRIPE_PRICE_TEAM_YEARLY=price_REPLACE_WITH_TEAM_YEARLY_ID

# Reserved and ignored while payment flows remain disabled:
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# ------------------------------------------------------------------------------
# 7. Plan Catalogue, Prices & Daily Per-Model Quotas (`services/nexora-auth`)
# ------------------------------------------------------------------------------
# No commercial terms or quota limits are approved. This template intentionally
# leaves currency, plan prices, model limits, trials, and feature policy unset.
# The production QuotaPolicy defaults to unconfigured; database seed rows are not
# proof of approval or paid access. Do not enable paid/quota behavior by copying
# draft values from billing source or database fixtures.

# ------------------------------------------------------------------------------
# 8. Desktop Application Build & Runtime Endpoint (`apps/desktop/src-tauri`)
# ------------------------------------------------------------------------------
# Base URL of `services/nexora-auth` reached over HTTP(S) from Rust (`AuthApiClient`).
# - Production Windows NSIS builds bake NEXORA_AUTH_API_URL at compile time via
#   option_env! and strictly require HTTPS; production runtime endpoint overrides
#   are rejected. Runtime override is for development/test only.
# - GOOGLE_OAUTH_CLIENT_ID is a public installed-app client ID embedded by the
#   Tauri build script when set; never put its confidential secret in the app.
# - Production rejects placeholder endpoints; an unset endpoint disables online
#   account calls without blocking local/offline chat.
# - HTTP is permitted only for loopback in development/test. In release builds,
#   also set NEXORA_ENV=development|test and the explicit opt-in below for QA.
NEXORA_AUTH_API_URL=http://127.0.0.1:8787
NEXORA_ALLOW_LOOPBACK_HTTP=false
