# ==============================================================================
# Nexora Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. Copy this file to `.env` on the backend host for local development:
#      cp .env.example .env && chmod 600 .env
#    NEVER commit `.env` or any file containing real credentials to Git.
# 2. Every secret below uses an unmistakable NON-PRODUCTION PLACEHOLDER.
#    When `NEXORA_ENV=production`, `services/nexora-auth` validates settings at
#    startup and refuses to start if `NEXORA_AUTH_DATABASE_URL` is missing, if
#    any configured secret or URL still contains placeholder tokens (`REPLACE_WITH`,
#    `CHANGE_ME`, `nexora.local`), or if `STRIPE_SECRET_KEY` uses `sk_test_*`.
# 3. NEVER prefix any secret with `VITE_`. Frontend bundles must never contain
#    server credentials, database strings, Stripe keys, or OAuth client secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Mode & Network Binding (`services/nexora-auth`)
# ------------------------------------------------------------------------------
# Allowed values: `development` | `test` | `production`
NEXORA_ENV=development

# Socket address `services/nexora-auth` listens on (`IP:PORT`).
# Non-loopback binds are rejected unless `NEXORA_AUTH_ALLOW_NON_LOOPBACK=true`.
NEXORA_AUTH_BIND=127.0.0.1:8787
NEXORA_AUTH_ALLOW_NON_LOOPBACK=false

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16+ Account, Billing & Quota Database (`services/nexora-auth`)
# ------------------------------------------------------------------------------
# Required in production (`?sslmode=require` recommended outside loopback).
NEXORA_AUTH_DATABASE_URL=postgresql://nexora_app:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:5432/nexora_auth

# Isolated database URL used exclusively by `cargo test -- --include-ignored`
# (truncates tables between integration tests — NEVER point at production!).
NEXORA_AUTH_TEST_DATABASE_URL=postgresql://postgres:REPLACE_WITH_TEST_DB_PASSWORD@127.0.0.1:5432/nexora_auth_test

# ------------------------------------------------------------------------------
# 3. Session, Password Recovery & Rate-Limit Policy (`services/nexora-auth`)
# ------------------------------------------------------------------------------
NEXORA_AUTH_VERIFICATION_TTL_SECONDS=86400
NEXORA_AUTH_SESSION_TTL_SECONDS=2592000
NEXORA_AUTH_SESSION_IDLE_TTL_SECONDS=604800
NEXORA_AUTH_RESET_TTL_SECONDS=3600

# Sliding-window rate rules (`<count>/<window>`, e.g. `5/15m`, `5/1h`, `3/1h`):
NEXORA_AUTH_RATE_LIMIT_LOGIN=5/15m
NEXORA_AUTH_RATE_LIMIT_REGISTER=5/1h
NEXORA_AUTH_RATE_LIMIT_RESEND=3/1h
NEXORA_AUTH_RATE_LIMIT_RECOVERY=3/1h

# ------------------------------------------------------------------------------
# 4. Transactional Email Provider (`services/nexora-auth`)
# ------------------------------------------------------------------------------
# Supported build value: `unconfigured` (honestly reports unconfigured delivery;
# setting `NEXORA_AUTH_SMTP_*` without an active transport fails fast rather than
# pretending mail was delivered).
NEXORA_AUTH_EMAIL_PROVIDER=unconfigured

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 + OIDC PKCE (`services/nexora-auth` & Desktop Client)
# ------------------------------------------------------------------------------
# Public Installed/Desktop OAuth Client ID opened by the desktop app with S256 PKCE:
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Confidential OAuth credentials — BACKEND SERVER ONLY (`services/nexora-auth`):
NEXORA_AUTH_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
NEXORA_AUTH_GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# RFC 8252 §7.3 loopback redirect base (`http://127.0.0.1/callback` permits dynamic
# ephemeral ports `http://127.0.0.1:<port>/callback` bound by the desktop client):
NEXORA_AUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1/callback

# ------------------------------------------------------------------------------
# 6. Payment Provider — Approved Roadmap Transition to Razorpay (Phase 15)
# ------------------------------------------------------------------------------
# ARCHITECTURE NOTE: Razorpay is the owner-approved payment provider replacing
# Stripe in Phase 15. Legacy `STRIPE_*` keys remain preserved below until the
# Phase 15 migration so existing backend tests continue compiling cleanly.
# BACKEND SERVER ONLY — never embed provider secret keys in desktop binaries:
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# Optional Stripe Price IDs mapped to server plan versions (falls back to inline
# `price_data` built strictly from server-configured amounts when omitted):
# STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_WITH_PRO_MONTHLY_ID
# STRIPE_PRICE_PRO_YEARLY=price_REPLACE_WITH_PRO_YEARLY_ID
# STRIPE_PRICE_TEAM_MONTHLY=price_REPLACE_WITH_TEAM_MONTHLY_ID
# STRIPE_PRICE_TEAM_YEARLY=price_REPLACE_WITH_TEAM_YEARLY_ID

# Browser return URLs presented after Stripe Checkout / Billing Portal sessions:
STRIPE_SUCCESS_URL=https://nexora.local/billing/success
STRIPE_CANCEL_URL=https://nexora.local/billing/cancel
STRIPE_PORTAL_RETURN_URL=https://nexora.local/billing/return

# ------------------------------------------------------------------------------
# 7. Configurable Plan Catalogue, Prices & Daily Per-Model Quotas (`services/nexora-auth`)
# ------------------------------------------------------------------------------
# PROPOSED DEFAULTS FOR PRODUCT REVIEW (authoritatively enforced on the server;
# client-submitted prices and counters are rejected/ignored):
# - Currency is a 3-letter ISO-4217 code; amounts are minor units (1900 = $19.00).
# - Daily per-model quotas reset strictly at 00:00:00 UTC each day.
NEXORA_BILLING_CURRENCY=USD

NEXORA_FREE_MINI_DAILY_LIMIT=25
NEXORA_FREE_SONNET_DAILY_LIMIT=5

NEXORA_PRO_MONTHLY_PRICE_CENTS=1900
NEXORA_PRO_YEARLY_PRICE_CENTS=19000
NEXORA_PRO_MINI_DAILY_LIMIT=300
NEXORA_PRO_SONNET_DAILY_LIMIT=100

NEXORA_TEAM_MONTHLY_PRICE_CENTS=3900
NEXORA_TEAM_YEARLY_PRICE_CENTS=39000
NEXORA_TEAM_MINI_DAILY_LIMIT=1000
NEXORA_TEAM_SONNET_DAILY_LIMIT=300

# ------------------------------------------------------------------------------
# 8. Desktop Application Build & Runtime Endpoint (`apps/desktop/src-tauri`)
# ------------------------------------------------------------------------------
# Base URL of `services/nexora-auth` reached over HTTP(S) from Rust (`AuthApiClient`).
# - Production Windows NSIS builds bake `NEXORA_AUTH_API_URL` at compile time via
#   `option_env!("NEXORA_AUTH_API_URL")` and strictly require `https://`.
# - Plaintext `http://` is ALWAYS rejected for non-loopback hosts in every mode.
# - Loopback `http://127.0.0.1:8787` is permitted only in debug builds or when
#   `NEXORA_ALLOW_LOOPBACK_HTTP=true` is explicitly set for local QA testing.
# - If unset in a release build, online account calls fail safely with
#   `backend_unconfigured` while local AI models and workspaces remain usable offline.
NEXORA_AUTH_API_URL=http://127.0.0.1:8787
# NEXORA_ALLOW_LOOPBACK_HTTP=false
